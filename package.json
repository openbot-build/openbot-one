{
  "name": "@openbot-build/one",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "The desktop and mobile shell for the shared OpenBot Web app",
  "packageManager": "pnpm@9.15.9",
  "scripts": {
    "tauri": "node scripts/tauri.mjs",
    "dev": "node scripts/web-assets.mjs dev",
    "build": "node scripts/web-assets.mjs build",
    "typecheck": "tsc --noEmit",
    "test": "node --test test/*.test.mjs",
    "desktop:dev": "node scripts/tauri.mjs dev",
    "desktop:build": "node scripts/tauri.mjs build",
    "android:init": "node scripts/tauri.mjs android init",
    "android:dev": "node scripts/tauri.mjs android dev",
    "android:build": "node scripts/tauri.mjs android build",
    "android:emulator": "node scripts/android-emulator.mjs",
    "android:check": "node e2e/android.mjs",
    "ios:init": "node scripts/tauri.mjs ios init",
    "ios:dev": "node scripts/tauri.mjs ios dev",
    "ios:build": "node scripts/tauri.mjs ios build",
    "native:check": "cargo check --locked --manifest-path src-tauri/Cargo.toml",
    "native:test": "cargo test --locked --manifest-path src-tauri/Cargo.toml",
    "desktop:check": "node e2e/desktop.mjs",
    "mail:check": "node e2e/mail.mjs",
    "credentials:check": "node e2e/credentials.mjs",
    "live:check": "node e2e/live-lifecycle.mjs",
    "backend:check": "node scripts/check-backend.mjs",
    "backend:login": "node scripts/check-backend.mjs --login",
    "backend:local": "node scripts/local-backend.mjs",
    "backend:local:stop": "docker compose -f dev/compose.yaml down",
    "media:check": "node e2e/media.mjs",
    "android:package": "node scripts/android-package.mjs",
    "browser:check": "node e2e/browser-sign-in.mjs",
    "credentials:native:check": "node e2e/credentials.mjs --native-only",
    "android:artifacts:check": "node scripts/check-android-artifacts.mjs",
    "clean:check": "node e2e/clean-build.mjs",
    "android:clean:check": "node e2e/clean-android-build.mjs",
    "linux:package": "node scripts/linux-package.mjs",
    "linux:install:check": "node scripts/linux-install-check.mjs",
    "notices:generate": "node scripts/rust-notices.mjs generate",
    "notices:check": "node scripts/rust-notices.mjs check"
  },
  "devDependencies": {
    "@openbot-build/web": "file:vendor/openbot-web/openbot-build-web-0.1.0-native-runtime.tgz",
    "@tauri-apps/api": "2.12.4",
    "@tauri-apps/cli": "2.12.4",
    "@tauri-apps/plugin-clipboard-manager": "2.5.0",
    "@tauri-apps/plugin-opener": "2.7.2",
    "@types/node": "26.6.5",
    "playwright-core": "1.64.1",
    "typescript": "7.0.2",
    "vite": "8.3.4",
    "ws": "8.22.0"
  }
}
