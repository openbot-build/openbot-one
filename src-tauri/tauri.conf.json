{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "OpenBot",
  "version": "../package.json",
  "identifier": "build.openbot.one",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "beforeBuildCommand": "pnpm build",
    "devUrl": "http://localhost:1420",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "label": "main",
        "title": "OpenBot",
        "create": false,
        "width": 1200,
        "height": 800,
        "minWidth": 360,
        "minHeight": 480,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "capabilities": [
        "main",
        "android",
        "lifecycle"
      ],
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self'; connect-src 'self' ipc: http://ipc.localhost https://ipc.localhost; media-src 'self' blob:; object-src 'none'; base-uri 'self'; frame-src 'none'; frame-ancestors 'none'; form-action 'none'"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "minimumSystemVersion": "13.3",
      "entitlements": "Entitlements.plist",
      "infoPlist": "Info.plist"
    },
    "iOS": {
      "minimumSystemVersion": "16.4",
      "infoPlist": "Info.plist"
    },
    "windows": {
      "minimumWebview2Version": "111.0.0.0"
    },
    "linux": {
      "deb": {
        "depends": ["libwebkit2gtk-4.1-0 (>= 2.40)"]
      },
      "appimage": {
        "bundleMediaFramework": true
      }
    }
  },
  "plugins": {
    "deep-link": {
      "mobile": [
        {
          "scheme": [
            "build.openbot.one"
          ],
          "path": [
            "/auth/callback"
          ]
        }
      ]
    }
  }
}
