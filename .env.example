# Local development backend. Release builds need an HTTPS service origin.
# This value is public and is included in the app. Do not put a secret here.
OPENBOT_DEFAULT_API_ORIGIN=http://localhost:19380

# Public native client ID. Register its callbacks in the service settings.
OPENBOT_NATIVE_CLIENT_ID=openbot-one

# Optional local UI override. The default build uses the locked Web package.
# OPENBOT_WEB_PACKAGE_DIR=../openbot-ui
