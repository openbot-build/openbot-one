diff --git a/scripts/runtime-manifest.mjs b/scripts/runtime-manifest.mjs
new file mode 100644
index 0000000..8565e42
--- /dev/null
+++ b/scripts/runtime-manifest.mjs
@@ -0,0 +1,27 @@
+import { copyFile, mkdir, writeFile, readFile } from "node:fs/promises"
+import { createRequire } from "node:module"
+import { dirname, join } from "node:path"
+
+const manifest = JSON.parse(await readFile(new URL("../package.json", import.meta.url), "utf8"))
+await writeFile(new URL("../dist/openbot-runtime.json", import.meta.url), JSON.stringify({
+	version: 1,
+	package: manifest.name,
+	packageVersion: manifest.version,
+	entry: "index.html",
+}, null, 2) + "\n")
+
+// Vite gathers bundled code notices. Preserve font licenses as separate assets.
+const require = createRequire(import.meta.url)
+const licenses = new URL("../dist/licenses/", import.meta.url)
+await mkdir(licenses, { recursive: true })
+const fonts = []
+for (const [name, file] of [
+	["@fontsource-variable/dm-sans", "dm-sans.txt"],
+	["@fontsource/dm-mono", "dm-mono.txt"],
+]) {
+	const path = require.resolve(name + "/package.json")
+	const font = JSON.parse(await readFile(path, "utf8"))
+	await copyFile(join(dirname(path), "LICENSE"), new URL(file, licenses))
+	fonts.push({ package: name, version: font.version, license: font.license, file })
+}
+await writeFile(new URL("fonts.json", licenses), JSON.stringify(fonts, null, 2) + "\n")
