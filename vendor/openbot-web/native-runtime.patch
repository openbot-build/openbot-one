diff --git a/test/live-audio.test.ts b/test/live-audio.test.ts
new file mode 100644
index 0000000..e6558fb
--- /dev/null
+++ b/test/live-audio.test.ts
@@ -0,0 +1,100 @@
+import assert from "node:assert/strict"
+import { test, type TestContext } from "node:test"
+import { startCapture } from "../src/lib/live-audio.ts"
+
+function deferred<T>() {
+	let resolve!: (value: T) => void
+	let reject!: (error: unknown) => void
+	const promise = new Promise<T>((yes, no) => { resolve = yes; reject = no })
+	return { promise, resolve, reject }
+}
+
+function media(t: TestContext, getUserMedia: () => Promise<MediaStream>) {
+	const descriptor = Object.getOwnPropertyDescriptor(globalThis.navigator, "mediaDevices")
+	Object.defineProperty(globalThis.navigator, "mediaDevices", { value: { getUserMedia }, configurable: true })
+	t.after(() => {
+		if (descriptor) Object.defineProperty(globalThis.navigator, "mediaDevices", descriptor)
+		else Reflect.deleteProperty(globalThis.navigator, "mediaDevices")
+	})
+}
+
+function stream() {
+	let stops = 0
+	return {
+		value: { getTracks: () => [{ stop: () => { stops++ } }] } as unknown as MediaStream,
+		stops: () => stops,
+	}
+}
+
+test("a canceled capture does not ask for a microphone, and a late grant is stopped", async t => {
+	const grant = deferred<MediaStream>()
+	let prompts = 0
+	media(t, () => { prompts++; return grant.promise })
+	const cancel = new AbortController()
+	cancel.abort()
+	await assert.rejects(startCapture({} as AudioContext, 24000, () => {}, cancel.signal), { name: "AbortError" })
+	assert.equal(prompts, 0)
+	const pending = new AbortController()
+	const capture = startCapture({} as AudioContext, 24000, () => {}, pending.signal)
+	pending.abort()
+	const input = stream()
+	grant.resolve(input.value)
+	await assert.rejects(capture, { name: "AbortError" })
+	assert.equal(prompts, 1)
+	assert.equal(input.stops(), 1)
+})
+
+test("cancel releases microphone tracks while the worklet module is still loading", async t => {
+	const input = stream()
+	media(t, async () => input.value)
+	const loading = deferred<void>()
+	const entered = deferred<void>()
+	const context = { audioWorklet: { addModule: () => { entered.resolve(); return loading.promise } } } as unknown as AudioContext
+	const cancel = new AbortController()
+	const capture = startCapture(context, 24000, () => {}, cancel.signal)
+	await entered.promise
+	cancel.abort()
+	assert.equal(input.stops(), 1)
+	loading.resolve()
+	await assert.rejects(capture, { name: "AbortError" })
+	assert.equal(input.stops(), 1)
+})
+
+test("worklet failure releases the microphone", async t => {
+	const input = stream()
+	media(t, async () => input.value)
+	const context = { audioWorklet: { addModule: async () => { throw new Error("Worklet failed") } } } as unknown as AudioContext
+	await assert.rejects(startCapture(context, 24000, () => {}), /Worklet failed/)
+	assert.equal(input.stops(), 1)
+})
+
+test("an active capture closes its port, nodes, and tracks once on cancel", async t => {
+	const input = stream()
+	media(t, async () => input.value)
+	let ports = 0, nodes = 0, sources = 0, chunks = 0
+	const port = { onmessage: null as null | ((event: { data: ArrayBuffer }) => void), close: () => { ports++ } }
+	const descriptor = Object.getOwnPropertyDescriptor(globalThis, "AudioWorkletNode")
+	Object.defineProperty(globalThis, "AudioWorkletNode", { configurable: true, value: class {
+		port = port
+		connect() {}
+		disconnect() { nodes++ }
+	} })
+	t.after(() => {
+		if (descriptor) Object.defineProperty(globalThis, "AudioWorkletNode", descriptor)
+		else Reflect.deleteProperty(globalThis, "AudioWorkletNode")
+	})
+	const context = {
+		audioWorklet: { addModule: async () => {} },
+		createMediaStreamSource: () => ({ connect() {}, disconnect() { sources++ } }),
+		destination: {},
+	} as unknown as AudioContext
+	const cancel = new AbortController()
+	const capture = await startCapture(context, 24000, () => { chunks++ }, cancel.signal)
+	port.onmessage?.({ data: new ArrayBuffer(2) })
+	assert.equal(chunks, 1)
+	cancel.abort()
+	capture.stop()
+	assert.equal(input.stops(), 1)
+	assert.deepEqual({ ports, nodes, sources }, { ports: 1, nodes: 1, sources: 1 })
+	assert.equal(port.onmessage, null)
+})
diff --git a/test/native-files.test.ts b/test/native-files.test.ts
new file mode 100644
index 0000000..081eb97
--- /dev/null
+++ b/test/native-files.test.ts
@@ -0,0 +1,77 @@
+import assert from "node:assert/strict"
+import { registerHooks } from "node:module"
+import { after, test } from "node:test"
+import * as AsyncResult from "effect/reactivity/AsyncResult"
+import * as AtomRegistry from "effect/reactivity/AtomRegistry"
+import { installRuntime } from "../src/lib/runtime.ts"
+
+const hooks = registerHooks({
+	resolve(specifier, context, nextResolve) {
+		return nextResolve(specifier.startsWith("@/")
+			? new URL(`../src/${specifier.slice(2)}.ts`, import.meta.url).href
+			: specifier, context)
+	},
+})
+after(() => hooks.deregister())
+
+const input = new File(["Native upload 世界"], "native.txt", { type: "text/plain" })
+const object = { id: "native-file", object: "file", filename: input.name, mediaType: input.type,
+	bytes: input.size, status: "ready", createdAt: 1 }
+let failStorage = false
+let released = false
+const seen: string[] = []
+installRuntime({
+	version: 1, kind: "native", apiOrigin: "https://service.test",
+	fetch: async (input, init) => {
+		const request = new Request(input, init)
+		seen.push(`${request.method} ${request.url}`)
+		if (request.url === "https://service.test/v1/files")
+			return Response.json({ _tag: "FilesDisabled", message: "Proxy uploads are off." }, { status: 409 })
+		if (request.url === "https://service.test/v1/files/uploads")
+			return Response.json({ file: { ...object, status: "pending" }, url: "https://storage.test/file?signed=value",
+				method: "PUT", headers: { "content-type": object.mediaType, "content-length": String(object.bytes) }, expiresAt: 1000 }, { status: 201 })
+		if (request.url.startsWith("https://storage.test/")) {
+			assert.ok(init?.signal)
+			assert.equal(await request.text(), "Native upload 世界")
+			return new Response(new ReadableStream({ cancel() { released = true } }), { status: failStorage ? 403 : 200 })
+		}
+		if (request.url === "https://service.test/v1/files/native-file/complete") {
+			assert.equal(released, true)
+			return Response.json(object)
+		}
+		throw new Error("Unexpected request.")
+	},
+	signIn: async () => {}, signOut: async () => {}, writeClipboard: async () => {}, openExternal: async () => {},
+	createWebSocket: () => { throw new Error("Not used in this test.") },
+})
+
+async function upload() {
+	const { uploadFileAtom } = await import("../src/atoms/files.ts")
+	const registry = AtomRegistry.make()
+	const unmount = registry.mount(uploadFileAtom)
+	try {
+		return await new Promise((resolve, reject) => {
+			registry.subscribe(uploadFileAtom, (value) => {
+				if (AsyncResult.isSuccess(value)) resolve(value.value)
+				else if (AsyncResult.isFailure(value)) reject(value.cause)
+			})
+			registry.set(uploadFileAtom, input)
+		})
+	} finally { unmount(); registry.dispose() }
+}
+
+test("direct file uploads use native transport and close storage responses before completion", { timeout: 5000 }, async (t) => {
+	t.mock.method(globalThis, "fetch", () => { throw new Error("Browser fetch must not receive native file requests.") })
+	assert.deepEqual(await upload(), object)
+	assert.deepEqual(seen, ["POST https://service.test/v1/files", "POST https://service.test/v1/files/uploads",
+		"PUT https://storage.test/file?signed=value", "POST https://service.test/v1/files/native-file/complete"])
+})
+
+test("a failed storage upload releases its response and cannot mark the file ready", { timeout: 5000 }, async () => {
+	failStorage = true
+	released = false
+	seen.length = 0
+	await assert.rejects(upload())
+	assert.equal(released, true)
+	assert.equal(seen.some((path) => path.endsWith("/complete")), false)
+})
